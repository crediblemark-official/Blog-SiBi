---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="SitusBisnis" class="w-7 h-7 object-contain" />
        <div>
          <span class="font-bold text-white tracking-tight">Blog SiBi</span>
          <p class="text-xs text-slate-400">Publikasi pemikiran & catatan strategis resmi dari SitusBisnis</p>
        </div>
      </div>

      <div class="flex items-center gap-6 text-xs sm:text-sm">
        <a href="https://situsbisnis.com" class="hover:text-amber-400 transition-colors">Platform SitusBisnis</a>
        <a href="https://situsbisnis.com/hub" class="hover:text-amber-400 transition-colors">Customer Hub</a>
        <a href="/" class="hover:text-amber-400 transition-colors">Arsip Artikel</a>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-slate-800 text-center md:text-left text-xs text-slate-500 flex flex-col md:flex-row justify-between items-center gap-4">
      <p>&copy; {currentYear} SitusBisnis. Hak cipta dilindungi undang-undang.</p>
      <p>Platform Hybrid Commerce & Creator Hub Terpadu Indonesia</p>
    </div>
  </div>
</footer>
