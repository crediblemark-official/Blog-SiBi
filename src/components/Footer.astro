---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200/90 bg-white py-8 sm:py-10 px-4 sm:px-6 lg:px-8 mt-16 sm:mt-24 select-none">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Row 1: Nav Links & Social Media Icons -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-5 text-center md:text-left">
      <!-- Navigation Links with Pipe Dividers (Centered on Mobile) -->
      <nav class="flex flex-wrap items-center justify-center md:justify-start gap-x-2.5 sm:gap-x-3 gap-y-1.5 text-xs sm:text-[13px] font-medium text-slate-600">
        <a href="https://situsbisnis.com" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 transition-colors">
          Platform SitusBisnis
        </a>
        <span class="text-slate-300 select-none">|</span>
        <a href="/" class="hover:text-amber-700 transition-colors">
          Semua Artikel
        </a>
        <span class="text-slate-300 select-none">|</span>
        <a href="/seri/" class="hover:text-amber-700 transition-colors font-semibold text-amber-900">
          Seri Panduan
        </a>
        <span class="text-slate-300 select-none">|</span>
        <a href="https://situsbisnis.com/terms" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 transition-colors">
          Syarat &amp; Ketentuan
        </a>
        <span class="text-slate-300 select-none">|</span>
        <a href="https://situsbisnis.com/privacy-policy" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 transition-colors">
          Kebijakan Privasi
        </a>
        <span class="text-slate-300 select-none">|</span>
        <a href="https://situsbisnis.com/kontak" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 transition-colors">
          Kontak
        </a>
      </nav>

      <!-- Social Media Icons Row -->
      <div class="flex items-center justify-center gap-2 shrink-0">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all hover:scale-105 active:scale-95"
          aria-label="Instagram">
          <svg class="w-3.5 h-3.5 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all hover:scale-105 active:scale-95"
          aria-label="X (Twitter)">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all hover:scale-105 active:scale-95"
          aria-label="YouTube">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all hover:scale-105 active:scale-95"
          aria-label="TikTok">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.77 1.81-.03 3.28-1.54 3.32-3.36.04-3.88.02-7.77.03-11.66-.01-.01-.01-.02 0-.03z"/></svg>
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all hover:scale-105 active:scale-95"
          aria-label="LinkedIn">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-slate-200/80"></div>

    <!-- Row 2: Brand Identity, Entity & Copyright -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-slate-500 w-full text-center md:text-left">
      <!-- Brand & Entity -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-2 gap-y-1 text-xs sm:text-[13px]">
        <a href="https://situsbisnis.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 group select-none shrink-0">
          <img src="/logo.png" alt="SitusBisnis" width="22" height="22" class="w-5 h-5 object-contain" />
          <span class="font-black tracking-tight text-slate-950 group-hover:text-amber-950 transition-colors">
            situsbisnis<span class="text-amber-600">.com</span>
          </span>
        </a>
        <span class="text-slate-400 select-none shrink-0">—</span>
        <span class="font-bold text-slate-800 tracking-tight shrink-0">
          PT HORIZON DIGITAL INDONESIA
        </span>
        <span class="text-slate-300 select-none shrink-0 hidden sm:inline">|</span>
        <span class="text-slate-400 text-[11px] hidden sm:inline">
          Publikasi Blog SiBi
        </span>
      </div>

      <!-- Copyright -->
      <div class="text-[11px] sm:text-xs text-slate-500 font-medium text-center md:text-right shrink-0 w-full md:w-auto">
        Copyright &copy; {currentYear} SitusBisnis. All Rights Reserved.
      </div>
    </div>

  </div>
</footer>
