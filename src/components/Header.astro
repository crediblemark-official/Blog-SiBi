---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const isCurrent = (path: string) => {
  const cleanPath = path.replace(/\/$/, '') || '/';
  if (cleanPath === '/') return pathname === '/';
  return pathname.startsWith(cleanPath);
};

const navItems = [
  { label: 'Seri Panduan', href: '/seri/', isSpecial: true, icon: '📚' },
  { label: 'Strategi Bisnis', href: '/kategori/strategi-bisnis/' },
  { label: 'Monetisasi', href: '/kategori/monetisasi/' },
  { label: 'Funnel Penjualan', href: '/kategori/funnel-penjualan/' },
  { label: 'Audience Growth', href: '/kategori/audience-growth/' },
  { label: 'Email Marketing', href: '/kategori/email-marketing/' },
];
---

<!-- Reading Progress Bar (Top) -->
<div id="reading-progress" class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-amber-500 to-amber-600 z-50 transition-all duration-75 w-0 pointer-events-none"></div>

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs select-none">
  <!-- 1. Main Header Bar (Logo, Desktop Nav & Primary Action) -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-2 lg:gap-4">
    
    <!-- Brand Logo (Aligned with SitusBisnis AppLogo.vue) -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 group shrink-0">
      <div class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-200">
        <img 
          src="/logo.png" 
          alt="SitusBisnis" 
          width="32" 
          height="32" 
          class="w-full h-full object-contain" 
        />
      </div>

      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 leading-none">
          <span class="text-lg sm:text-xl font-black tracking-tight text-slate-950 group-hover:text-amber-950 transition-colors">
            Blog <span class="text-amber-600">SiBi</span>
          </span>
          <span class="text-[9.5px] sm:text-[10px] font-bold text-amber-900 bg-amber-100 border border-amber-300/70 px-1.5 py-0.5 rounded-full font-mono tracking-wider lowercase">
            official
          </span>
        </div>
        <span class="text-[10px] text-slate-400 font-medium hidden sm:block mt-0.5">
          by SitusBisnis.com
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Menu (In Header on Desktop: lg and up) -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-xs font-semibold select-none">
      {navItems.map((item) => {
        const active = isCurrent(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "px-2.5 xl:px-3 py-1.5 rounded-full transition-all shrink-0 inline-flex items-center gap-1.5",
              active
                ? "bg-slate-950 text-white font-bold shadow-2xs"
                : item.isSpecial
                  ? "bg-amber-50 text-amber-900 border border-amber-300/80 hover:bg-amber-100 font-bold"
                  : "text-slate-600 hover:text-amber-700 hover:bg-slate-100/90"
            ]}
          >
            {item.icon && <span>{item.icon}</span>}
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- Right Controls / Navigation -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Direct Link to Main Platform -->
      <a 
        href="https://situsbisnis.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-800 bg-slate-100 hover:bg-amber-500 hover:text-white px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl transition-all duration-150 shadow-2xs active:scale-95"
        title="Buka Platform Utama SitusBisnis"
      >
        <span>SitusBisnis</span>
        <svg class="w-3.5 h-3.5 stroke-[2.2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  <!-- 2. Sub-Navigation: Horizontal Scroll on Mobile/Tablet (Full Edge), Hidden on Desktop -->
  <nav class="lg:hidden border-t border-slate-100 bg-white/95 w-full">
    <div class="max-w-7xl mx-auto px-0 sm:px-6 lg:px-8">
      <div class="w-full flex items-center gap-1.5 sm:gap-2 overflow-x-auto py-2 px-4 sm:px-0 no-scrollbar whitespace-nowrap text-xs font-semibold after:content-[''] after:w-2 sm:after:hidden after:shrink-0">
        {navItems.map((item) => {
          const active = isCurrent(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "px-3 py-1.5 rounded-full transition-all shrink-0 inline-flex items-center gap-1.5 select-none",
                active
                  ? "bg-slate-950 text-white font-bold shadow-2xs"
                  : item.isSpecial
                    ? "bg-amber-50 text-amber-900 border border-amber-300/80 hover:bg-amber-100 font-bold"
                    : "text-slate-600 hover:text-amber-700 hover:bg-slate-100/90"
              ]}
            >
              {item.icon && <span>{item.icon}</span>}
              <span>{item.label}</span>
            </a>
          );
        })}
      </div>
    </div>
  </nav>
</header>

<script>
  // Dynamic Scroll Progress Bar
  const progressBar = document.getElementById('reading-progress');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    }, { passive: true });
  }
</script>
