---
import BaseLayout from './BaseLayout.astro';
import { slugify } from '../utils/slug';
import type { SeriesContext } from '../utils/series';

interface Props {
  title: string;
  description: string;
  date: Date;
  categories?: string[];
  tags?: string[];
  author?: string;
  image?: string;
  headings?: { depth: number; slug: string; text: string }[];
  readingTimeMinutes?: number;
  relatedPosts?: any[];
  seriesContext?: SeriesContext | null;
}

const {
  title,
  description,
  date,
  categories = [],
  tags = [],
  author = 'Tim SitusBisnis',
  image = '/images/posts/creator-commerce-cover.svg',
  headings = [],
  readingTimeMinutes = 5,
  relatedPosts = [],
  seriesContext = null,
} = Astro.props;

const primaryCategory = categories[0] || 'Strategi Bisnis';

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(new Date(date));
const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: primaryCategory, url: `/kategori/${slugify(primaryCategory)}/` },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout 
  title={title} 
  description={description} 
  image={image} 
  type="article"
  publishedTime={new Date(date)}
  author={author}
  section={primaryCategory}
  tags={tags}
  breadcrumbs={breadcrumbs}
>
  
  <!-- Centered Single Column Article Container (Full edge on mobile px-0, padded on desktop) -->
  <article class="w-full bg-white">
    <div class="max-w-3xl mx-auto px-0 sm:px-6 pt-4 sm:pt-10 pb-12 sm:pb-16">
      
      <!-- 1. Back to Blog Link (Padded on mobile) -->
      <div class="px-4 sm:px-0 mb-4 sm:mb-8">
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-amber-600 hover:text-amber-700 transition-colors group"
        >
          <svg class="w-4 h-4 text-amber-600 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Kembali ke Blog</span>
        </a>
      </div>

      <!-- 2. Featured Hero Image (STRICT FULL EDGE ON MOBILE: rounded-none, border-x-0, w-full) -->
      <div class="w-full mb-6 sm:mb-10 rounded-none sm:rounded-3xl overflow-hidden border-y sm:border border-slate-200/80 shadow-none sm:shadow-xs aspect-[16/10] sm:aspect-[16/9] bg-slate-100">
        <img 
          src={image} 
          alt={title}
          class="w-full h-full object-cover" 
          loading="eager"
        />
      </div>

      <!-- 3. Article Header & Content Wrapper (Clean safe horizontal padding on mobile) -->
      <div class="px-4 sm:px-0">
        
        <!-- Article Header -->
        <header class="mb-8 sm:mb-10">
          <!-- Series Hero Pill & Progress Bar -->
          {seriesContext && (
            <div class="mb-5 sm:mb-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 p-3 sm:p-4">
              <div class="flex items-center justify-between gap-3 text-xs mb-2">
                <div class="flex items-center gap-1.5 font-mono font-bold text-amber-950">
                  <span>📚</span>
                  <a href={`/seri/${seriesContext.id}/`} class="hover:underline">
                    SERI: {seriesContext.name}
                  </a>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-amber-500 text-white font-mono font-bold text-[10px] shrink-0">
                  Bagian {seriesContext.currentPart} dari {seriesContext.totalParts}
                </span>
              </div>
              <div class="w-full bg-amber-200/60 rounded-full h-1.5 overflow-hidden">
                <div 
                  class="bg-amber-600 h-full rounded-full transition-all duration-500" 
                  style={`width: ${Math.round((seriesContext.currentPart / seriesContext.totalParts) * 100)}%`}
                ></div>
              </div>
            </div>
          )}

          <!-- Category Badges -->
          <div class="flex flex-wrap items-center gap-2 mb-3.5 sm:mb-4">
            {categories.map((cat, idx) => (
              <a 
                href={`/kategori/${slugify(cat)}/`}
                class:list={[
                  "px-3 py-1 rounded-full text-xs font-bold font-mono tracking-tight transition-all hover:scale-105 active:scale-95",
                  idx === 0 
                    ? "bg-emerald-50 text-emerald-800 border border-emerald-200/80 hover:bg-emerald-100" 
                    : "bg-amber-50 text-amber-900 border border-amber-200/80 hover:bg-amber-100"
                ]}
              >
                {cat}
              </a>
            ))}
          </div>

          <!-- Big Headline -->
          <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-black tracking-tight text-slate-950 leading-[1.2] mb-3 sm:mb-4">
            {title}
          </h1>

          <!-- Excerpt / Subtitle -->
          <p class="text-sm sm:text-base lg:text-lg text-slate-600 leading-relaxed font-normal mb-6">
            {description}
          </p>

          <!-- Author & Byline Row -->
          <div class="flex items-center justify-between gap-4 pt-4 border-t border-slate-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-amber-50 border border-amber-200/80 p-1 flex items-center justify-center shrink-0 shadow-2xs">
                <img src="/logo.png" alt={author} class="w-full h-full object-contain" />
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-slate-950 text-xs sm:text-sm">{author}</span>
                  <span class="text-[9.5px] font-semibold text-amber-800 bg-amber-100/80 px-1.5 py-0.2 rounded font-mono">Editorial</span>
                </div>
                <div class="flex items-center gap-2 text-slate-500 text-[11px] sm:text-xs mt-0.5">
                  <time datetime={date.toISOString()}>{formattedDate}</time>
                  <span class="text-slate-300">•</span>
                  <span>{readingTimeMinutes} menit baca</span>
                </div>
              </div>
            </div>

            <!-- Salin Tautan Button -->
            <button 
              id="copy-link-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 active:scale-95 text-slate-600 hover:text-slate-900 text-xs font-semibold transition-all shadow-2xs cursor-pointer select-none"
              title="Salin tautan artikel"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-text" class="hidden sm:inline">Salin Tautan</span>
            </button>
          </div>
        </header>

        <!-- Series Curriculum Accordion Drawer -->
        {seriesContext && (
          <details class="mb-8 rounded-2xl border border-slate-200/90 bg-slate-50/70 p-4 sm:p-5 group select-none">
            <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-slate-900 text-xs sm:text-sm">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span>Silabus Seri: {seriesContext.name} ({seriesContext.totalParts} Bagian)</span>
              </div>
              <span class="text-xs text-amber-700 font-semibold group-open:hidden">Buka Silabus ↓</span>
              <span class="text-xs text-slate-400 font-semibold hidden group-open:inline">Tutup Silabus ↑</span>
            </summary>

            <div class="mt-4 pt-4 border-t border-slate-200/80 space-y-2">
              {seriesContext.parts.map((item) => (
                <div class:list={[
                  "flex items-center justify-between gap-3 p-2.5 rounded-xl text-xs transition-colors",
                  item.isCurrent 
                    ? "bg-amber-100/70 border border-amber-300/80 text-amber-950 font-bold" 
                    : "bg-white hover:bg-slate-100/80 border border-slate-200/60 text-slate-700"
                ]}>
                  <div class="flex items-center gap-2 min-w-0">
                    <span class:list={[
                      "w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-mono shrink-0 font-bold",
                      item.isCurrent ? "bg-amber-600 text-white" : "bg-slate-200 text-slate-600"
                    ]}>
                      {item.part}
                    </span>
                    {item.isCurrent ? (
                      <span class="truncate">{item.title}</span>
                    ) : (
                      <a href={`/posts/${item.slug}/`} class="truncate hover:text-amber-600 hover:underline">
                        {item.title}
                      </a>
                    )}
                  </div>
                  {item.isCurrent ? (
                    <span class="text-[10px] font-mono uppercase tracking-wider text-amber-800 bg-amber-200/80 px-2 py-0.5 rounded shrink-0">
                      Sedang Dibaca
                    </span>
                  ) : (
                    <a href={`/posts/${item.slug}/`} class="text-[11px] font-semibold text-amber-600 shrink-0 hover:underline">
                      Baca →
                    </a>
                  )}
                </div>
              ))}
            </div>
          </details>
        )}

        <!-- 4. Article Content (Centered Single Column Typography, Full Edge media on mobile) -->
        <div class="prose prose-slate prose-base sm:prose-lg max-w-none
          prose-headings:font-black prose-headings:tracking-tight prose-headings:text-slate-950
          prose-h2:text-xl sm:prose-h2:2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pt-2
          prose-h3:text-lg sm:prose-h3:xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-slate-700 prose-p:leading-[1.8] prose-p:mb-6
          prose-a:text-amber-600 prose-a:font-semibold hover:prose-a:text-amber-700 prose-a:underline-offset-4
          prose-strong:text-slate-950 prose-strong:font-bold
          prose-blockquote:border-l-4 prose-blockquote:border-slate-900 prose-blockquote:bg-slate-50/70 prose-blockquote:py-4 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:text-slate-800 prose-blockquote:not-italic prose-blockquote:my-8
          prose-img:-mx-4 sm:prose-img:mx-auto prose-img:w-[calc(100%+2rem)] sm:prose-img:w-full prose-img:rounded-none sm:prose-img:rounded-2xl prose-img:border-y sm:prose-img:border prose-img:border-slate-200/80 prose-img:my-6
          prose-table:text-xs sm:prose-table:text-sm
          prose-th:bg-slate-50 prose-th:p-3 prose-th:text-slate-900
          prose-td:p-3 prose-td:border-t prose-td:border-slate-100
          prose-code:text-amber-700 prose-code:bg-amber-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs prose-code:font-mono
          prose-pre:-mx-4 sm:prose-pre:mx-auto prose-pre:rounded-none sm:prose-pre:rounded-2xl prose-pre:bg-slate-950 prose-pre:text-slate-100 prose-pre:p-4 sm:prose-pre:p-5 prose-pre:border-y sm:prose-pre:border prose-pre:border-slate-800">
          <slot />
        </div>

        <!-- 5. Topic Tags Row -->
        {tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-slate-100 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-1 font-mono">Topik:</span>
            {tags.map((tag) => (
              <a 
                href={`/tags/${slugify(tag)}/`}
                class="text-xs font-medium text-slate-600 hover:text-amber-800 bg-slate-100 hover:bg-amber-50 border border-transparent hover:border-amber-200/80 px-2.5 py-1 rounded-md transition-all active:scale-95"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- 6. Series Next / Previous Episode Cards -->
        {seriesContext && (seriesContext.prevPost || seriesContext.nextPost) && (
          <div class="mt-10 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Previous Post -->
            {seriesContext.prevPost ? (
              <a 
                href={`/posts/${seriesContext.prevPost.slug}/`}
                class="group p-4 rounded-2xl border border-slate-200 hover:border-amber-300 bg-white hover:bg-amber-50/30 transition-all flex flex-col justify-between"
              >
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 group-hover:text-amber-700 block mb-1 font-bold">
                    ← Bagian {seriesContext.prevPost.part} (Sebelumnya)
                  </span>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-amber-600 line-clamp-2 transition-colors">
                    {seriesContext.prevPost.title}
                  </h4>
                </div>
                <span class="text-xs font-semibold text-slate-500 group-hover:text-amber-600 mt-3 inline-flex items-center gap-1">
                  Baca bab sebelumnya
                </span>
              </a>
            ) : (
              <div class="p-4 rounded-2xl border border-dashed border-slate-200 text-slate-400 text-xs flex items-center justify-center text-center">
                <span>Ini adalah episode pembuka dari seri ini.</span>
              </div>
            )}

            <!-- Next Post -->
            {seriesContext.nextPost ? (
              <a 
                href={`/posts/${seriesContext.nextPost.slug}/`}
                class="group p-4 rounded-2xl border border-amber-300 hover:border-amber-400 bg-amber-50/50 hover:bg-amber-100/50 transition-all flex flex-col justify-between text-right"
              >
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-amber-800 block mb-1 font-bold">
                    Bagian {seriesContext.nextPost.part} (Selanjutnya) →
                  </span>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-950 group-hover:text-amber-700 line-clamp-2 transition-colors">
                    {seriesContext.nextPost.title}
                  </h4>
                </div>
                <span class="text-xs font-bold text-amber-700 mt-3 inline-flex items-center justify-end gap-1">
                  Lanjut membaca bab ini →
                </span>
              </a>
            ) : (
              <div class="p-4 rounded-2xl border border-dashed border-slate-200 text-slate-400 text-xs flex items-center justify-center text-center">
                <span>Episode berikutnya sedang dalam penulisan redaksi.</span>
              </div>
            )}
          </div>
        )}
      </div>

    </div>
  </article>

  <!-- 6. "You Might Also Like" / Artikel Terkait Section (Full edge on mobile) -->
  {relatedPosts.length > 0 && (
    <section class="w-full bg-slate-50/70 border-t border-slate-200/80 py-10 sm:py-16">
      <div class="max-w-6xl mx-auto px-0 sm:px-6 lg:px-8">
        
        <!-- Header text (padded on mobile) -->
        <div class="px-4 sm:px-0 flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 sm:mb-10">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">
              Artikel Terkait Lainnya
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Eksplorasi strategi bisnis digital, monetisasi, dan panduan mendalam lainnya dari Blog SiBi.
            </p>
          </div>
          <a href="/" class="text-xs sm:text-sm font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1 shrink-0 group">
            <span>Lihat Semua Artikel</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- Cards: Full-edge divide on mobile, 3-column cards on desktop -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-0 sm:gap-8 divide-y sm:divide-y-0 divide-slate-200/80">
          {relatedPosts.map((rPost) => {
            const rSlug = rPost.id.replace(/\.mdx?$/, '');
            const rDate = new Intl.DateTimeFormat('id-ID', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            }).format(new Date(rPost.data.date));
            const rCat = rPost.data.categories?.[0] || 'Strategi';
            return (
              <article class="group flex flex-col bg-white rounded-none sm:rounded-2xl border-x-0 sm:border border-y sm:border-y border-slate-200/80 overflow-hidden hover:border-amber-500/50 hover:shadow-md transition-all duration-200">
                <a href={`/posts/${rSlug}/`} class="aspect-[16/10] overflow-hidden bg-slate-100 block relative">
                  <img 
                    src={rPost.data.image || "/images/posts/creator-commerce-cover.svg"} 
                    alt={rPost.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </a>
                <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <a 
                      href={`/kategori/${slugify(rCat)}/`}
                      class="inline-block text-amber-800 bg-amber-50 hover:bg-amber-100 px-2 py-0.5 rounded-full border border-amber-200/60 font-semibold font-mono text-[10px] mb-2.5 transition-colors"
                    >
                      {rCat}
                    </a>
                    <h3 class="text-sm sm:text-base font-bold text-slate-950 group-hover:text-amber-600 transition-colors line-clamp-2 leading-snug mb-2">
                      <a href={`/posts/${rSlug}/`}>
                        {rPost.data.title}
                      </a>
                    </h3>
                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
                      {rPost.data.description}
                    </p>
                  </div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                    <span>{rPost.data.author}</span>
                    <time datetime={rPost.data.date.toISOString()}>{rDate}</time>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- 7. Bottom CTA Section (Full edge on mobile) -->
  <section class="w-full bg-white py-0 sm:py-16 border-t border-slate-200/80">
    <div class="max-w-5xl mx-auto px-0 sm:px-6 lg:px-8">
      <div class="rounded-none sm:rounded-3xl border-x-0 sm:border border-y sm:border-y border-slate-200/90 bg-gradient-to-br from-slate-50 via-white to-amber-50/40 px-4 py-8 sm:p-10 lg:p-12 shadow-none sm:shadow-xs flex flex-col lg:flex-row items-center justify-between gap-8 sm:gap-10">
        <div class="w-full lg:max-w-xl">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-900 text-[10px] font-bold uppercase tracking-wider mb-3 font-mono">
            Ekosistem SitusBisnis
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight leading-tight mb-3">
            Tingkatkan Pertumbuhan Bisnis Digital Anda
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
            Gunakan platform <strong>SitusBisnis</strong> untuk membuat landing page visual siap konversi, menjual e-book, kelas online, layanan konsultasi, hingga produk fisik dengan checkout instan (QRIS & Virtual Account) tanpa potongan komisi.
          </p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a 
              href="https://situsbisnis.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 active:scale-95 text-white font-bold text-xs sm:text-sm transition-all shadow-sm text-center"
            >
              <span>Mulai Buat Toko Gratis</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a 
              href="https://situsbisnis.com/#features" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-slate-700 hover:text-slate-950 font-semibold text-xs sm:text-sm transition-colors text-center"
            >
              Lihat Semua Fitur →
            </a>
          </div>
        </div>

        <!-- Visual Dashboard Card Illustration -->
        <div class="w-full lg:w-72 shrink-0 bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs space-y-3">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <img src="/logo.png" alt="SitusBisnis" class="w-5 h-5 object-contain" />
              <span class="font-bold text-xs text-slate-900">SitusBisnis Hub</span>
            </div>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-mono text-[9px] font-black">ONLINE</span>
          </div>
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between text-slate-500 text-[11px]">
              <span>Total Pendapatan</span>
              <span class="text-emerald-600 font-bold font-mono">100% Anda</span>
            </div>
            <div class="text-lg font-black text-slate-950 font-mono">Rp 18.450.000</div>
            <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-amber-500 rounded-full w-4/5"></div>
            </div>
          </div>
          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-mono">
            <span>Biaya Transaksi</span>
            <span class="text-amber-700 font-bold">0% (Zero Fee ⭐)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Script for Single Post Interactive Actions -->
</BaseLayout>

<script>
  // Copy Link Action
  const copyBtn = document.getElementById('copy-link-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = 'Tersalin! ✓';
        copyBtn.classList.add('text-amber-700', 'border-amber-300', 'bg-amber-50');
        setTimeout(() => {
          copyBtnText.textContent = originalText;
          copyBtn.classList.remove('text-amber-700', 'border-amber-300', 'bg-amber-50');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  }

  // Dynamic Mermaid Renderer (Zero Overhead when not present)
  const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
  if (mermaidBlocks.length > 0) {
    import('mermaid').then(({ default: mermaid }) => {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'neutral',
        themeVariables: {
          primaryColor: '#fffbeb',
          primaryTextColor: '#78350f',
          primaryBorderColor: '#f59e0b',
          lineColor: '#d97706',
          fontFamily: "'Plus Jakarta Sans', sans-serif",
          fontSize: '13px',
        },
        flowchart: {
          curve: 'basis',
          nodeSpacing: 35,
          rankSpacing: 40,
          padding: 12,
          htmlLabels: true,
        }
      });

      mermaidBlocks.forEach(async (block, idx) => {
        const rawCode = block.textContent?.trim() || '';
        if (rawCode) {
          try {
            const chartId = `mermaid-svg-${idx}-${Date.now()}`;
            const { svg } = await mermaid.render(chartId, rawCode);
            const wrapper = document.createElement('div');
            wrapper.className = 'mermaid-container my-8 p-5 sm:p-7 rounded-2xl bg-amber-500/5 border border-amber-500/20 flex flex-col items-center justify-center overflow-x-auto shadow-2xs select-none';
            wrapper.innerHTML = svg;
            block.replaceWith(wrapper);
          } catch (err) {
            console.error('Mermaid render error: ', err);
          }
        }
      });
    });
  }
</script>
