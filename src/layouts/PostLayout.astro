---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  categories?: string[];
  tags?: string[];
  author?: string;
  headings?: { depth: number; slug: string; text: string }[];
  readingTimeMinutes?: number;
}

const {
  title,
  description,
  date,
  categories = [],
  tags = [],
  author = 'Tim SitusBisnis',
  headings = [],
  readingTimeMinutes = 5
} = Astro.props;

const primaryCategory = categories[0] || 'Esai & Studi Kasus';

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(new Date(date));

const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description} type="article">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Clean & Non-redundant Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-amber-600 transition-colors flex items-center gap-1">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Beranda</span>
      </a>
      <span class="text-slate-300">/</span>
      <span class="inline-flex items-center text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200/70 font-semibold text-xs">
        {primaryCategory}
      </span>
    </nav>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Article Area (8 cols) -->
      <main class="lg:col-span-8 bg-white p-6 sm:p-10 md:p-12 rounded-2xl border border-slate-200/80 shadow-xs">
        <!-- Article Header -->
        <header class="mb-10 pb-8 border-b border-slate-100">
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-black tracking-tight text-slate-950 leading-[1.25] mb-5">
            {title}
          </h1>

          <p class="text-lg text-slate-600 leading-relaxed font-normal mb-6">
            {description}
          </p>

          <!-- Meta Author & Time -->
          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100/80 text-xs sm:text-sm text-slate-500">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center p-1.5 shadow-xs">
                <img src="/logo.png" alt="SitusBisnis" class="w-full h-full object-contain" />
              </div>
              <div>
                <span class="font-bold text-slate-900 block leading-tight">{author}</span>
                <span class="text-slate-400 text-xs">Kurasi Resmi SitusBisnis</span>
              </div>
            </div>

            <div class="flex items-center gap-4 text-xs font-medium text-slate-500">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {formattedDate}
              </span>
              <span>•</span>
              <span class="flex items-center gap-1.5 text-amber-700 bg-amber-50/80 px-2 py-0.5 rounded font-mono text-[11px] font-semibold border border-amber-200/50">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {readingTimeMinutes} menit baca
              </span>
            </div>
          </div>
        </header>

        <!-- Markdown Body -->
        <article class="prose prose-slate prose-base sm:prose-lg max-w-none 
          prose-headings:font-black prose-headings:tracking-tight prose-headings:text-slate-950
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-slate-100
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-slate-700 prose-p:leading-[1.8]
          prose-a:text-amber-600 prose-a:font-semibold hover:prose-a:text-amber-700 prose-a:underline-offset-4
          prose-strong:text-slate-900 prose-strong:font-bold
          prose-blockquote:border-l-4 prose-blockquote:border-amber-500 prose-blockquote:bg-amber-50/40 prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:text-slate-800 prose-blockquote:not-italic
          prose-table:text-sm prose-table:border prose-table:border-slate-200 prose-table:rounded-xl
          prose-th:bg-slate-50 prose-th:p-3 prose-th:text-slate-900
          prose-td:p-3 prose-td:border-t prose-td:border-slate-100
          prose-code:text-amber-700 prose-code:bg-amber-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs prose-code:font-mono
          prose-pre:bg-slate-950 prose-pre:text-slate-100 prose-pre:rounded-xl prose-pre:p-4 prose-pre:border prose-pre:border-slate-800">
          <slot />
        </article>

        <!-- Tags List -->
        {tags.length > 0 && (
          <div class="mt-12 pt-6 border-t border-slate-100 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-2 font-mono">Topik:</span>
            {tags.map((tag) => (
              <span class="text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 px-2.5 py-1 rounded-md transition-colors">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Conversion Bridge / Call-to-Action Box -->
        <section class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-amber-500/20 relative overflow-hidden">
          <div class="relative z-10">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500 text-white font-bold text-[11px] uppercase tracking-wider mb-3">
              Solusi Terpadu
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight mb-2">
              Siap Menerapkan Strategi di Atas pada Bisnis Anda?
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6 max-w-2xl">
              Gunakan platform <strong>SitusBisnis</strong> untuk membuat landing page visual yang terkonversi, menjual produk digital/fisik, kelas online, hingga konsultasi dengan single-page checkout otomatis (QRIS Dinamis & Virtual Account).
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <a 
                href="https://situsbisnis.com" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm transition-all shadow-sm hover:shadow"
              >
                <span>Mulai Buat Toko Gratis</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a 
                href="https://situsbisnis.com/#features" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center px-4 py-2.5 rounded-xl text-slate-700 hover:text-slate-950 font-semibold text-sm transition-colors"
              >
                Pelajari Fitur Lengkap →
              </a>
            </div>
          </div>
        </section>
      </main>

      <!-- Sticky Sidebar for Desktop (4 cols) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-24 space-y-6">
        <!-- Table of Contents Card -->
        {filteredHeadings.length > 0 && (
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-400 mb-4 font-mono flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
              </svg>
              Daftar Isi Esai
            </h3>
            <nav class="space-y-1 text-sm">
              {filteredHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    'block py-1.5 transition-colors line-clamp-1',
                    heading.depth === 2
                      ? 'font-semibold text-slate-700 hover:text-amber-600'
                      : 'pl-4 text-xs text-slate-500 hover:text-amber-600'
                  ]}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Quick About Card -->
        <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-xs">
          <div class="flex items-center gap-2.5 mb-3">
            <img src="/logo.png" alt="SitusBisnis" class="w-6 h-6 object-contain" />
            <span class="font-bold text-sm tracking-tight">Tentang Blog SiBi</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Publikasi catatan strategis dan riset industri yang dikurasi oleh tim SitusBisnis untuk membantu kreator dan pebisnis digital Indonesia tumbuh berkelanjutan.
          </p>
          <a 
            href="https://situsbisnis.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1"
          >
            Kunjungi Platform Utama ↗
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
