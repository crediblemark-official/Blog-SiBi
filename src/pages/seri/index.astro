---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllSeries } from '../../utils/series';

const posts = await getCollection('blog');
const allSeries = getAllSeries(posts);
---

<BaseLayout
  title="Daftar Seri Panduan & Masterclass — Blog SiBi"
  description="Kumpulan panduan berseri komprehensif, mulai dari validasi produk hingga strategi skala bisnis digital."
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Seri Panduan', url: '/seri/' },
  ]}
>
  <div class="w-full max-w-5xl mx-auto px-0 sm:px-6 lg:px-8 py-4 sm:py-12 lg:py-14">
    
    <header class="px-4 sm:px-0 mb-10 sm:mb-16 text-center max-w-3xl mx-auto flex flex-col items-center">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4 font-medium">
        <a href="/" class="hover:text-amber-600 transition-colors">Beranda</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-semibold">Seri Panduan</span>
      </nav>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-900 text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-3 sm:mb-4 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Indeks Seri Lengkap
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-950 leading-[1.18] mb-3 sm:mb-4">
        Seri Masterclass &amp; Panduan Mendalam
      </h1>

      <p class="text-xs sm:text-base text-slate-600 leading-relaxed font-normal max-w-xl">
        Kumpulan esai berseri yang dirancang dari 0 sampai selesai untuk membimbing Anda membangun bisnis digital mandiri secara terstruktur.
      </p>
    </header>

    <div class="px-4 sm:px-0 space-y-6 mb-16 sm:mb-24">
      {allSeries.map((s) => {
        const firstPost = s.posts[0];
        const firstSlug = firstPost?.id.replace(/\.mdx?$/, '');
        return (
          <div class="bg-white rounded-2xl border border-slate-200/90 hover:border-amber-400 p-6 sm:p-8 transition-all hover:shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="max-w-xl">
              <div class="flex items-center gap-2 text-xs font-mono mb-2">
                <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 font-bold">
                  {s.posts.length} / {s.totalParts} Bagian
                </span>
                <span class="text-slate-400">•</span>
                <span class="text-slate-500">Kurikulum Berkelanjutan</span>
              </div>
              <h2 class="text-lg sm:text-2xl font-bold text-slate-950 hover:text-amber-600 transition-colors mb-2">
                <a href={`/seri/${s.id}/`}>
                  {s.name}
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Panduan komprehensif mulai dari validasi ide, penetapan harga, pembuatan lead magnet, copywriting konversi, hingga arsitektur funnel terpadu.
              </p>
              <div class="flex items-center gap-3 text-xs text-slate-500">
                <span class="font-medium text-slate-800">Episode Pertama:</span>
                <a href={`/posts/${firstSlug}/`} class="text-amber-700 hover:underline line-clamp-1">
                  {firstPost?.data.title}
                </a>
              </div>
            </div>

            <div class="shrink-0 flex flex-col sm:flex-row gap-2 w-full md:w-auto">
              <a
                href={`/seri/${s.id}/`}
                class="px-5 py-2.5 rounded-xl border border-slate-300 hover:border-slate-400 text-slate-800 text-xs sm:text-sm font-semibold text-center transition-colors"
              >
                Lihat Silabus
              </a>
              {firstSlug && (
                <a
                  href={`/posts/${firstSlug}/`}
                  class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs sm:text-sm font-bold text-center transition-all shadow-sm"
                >
                  Mulai Baca →
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</BaseLayout>
