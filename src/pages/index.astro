---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout 
  title="Blog SiBi — Eksplorasi Mendalam & Strategi Bisnis Digital"
  description="Catatan strategis, studi kasus konversi, dan panduan komprehensif seputar creator economy dari tim SitusBisnis."
>
  <!-- Full edge on mobile (px-0 py-0), padded container on desktop -->
  <div class="w-full max-w-7xl mx-auto px-0 sm:px-6 lg:px-8 py-0 sm:py-12 lg:py-14">
    
    <!-- Hero Section (Full edge flush on mobile, padded on desktop) -->
    <header class="w-full max-w-3xl px-4 py-6 sm:px-0 sm:py-0 sm:mb-14 bg-white sm:bg-transparent border-b sm:border-b-0 border-slate-200/80">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-900 text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-2.5 sm:mb-3.5 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        Publikasi Resmi SitusBisnis
      </div>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-950 leading-[1.2] mb-2 sm:mb-4">
        Catatan Strategis, Riset, & Panduan Bisnis Digital
      </h1>
      <p class="text-xs sm:text-lg text-slate-600 leading-relaxed font-normal">
        Tulisan mendalam tanpa basa-basi untuk membantu kreator, mentor, dan pengusaha digital membangun ekosistem bisnis yang menguntungkan dan mandiri.
      </p>
    </header>

    <!-- Post List Section: Full edge divided list on mobile, separated cards on desktop -->
    <section class="w-full bg-white sm:bg-transparent border-b sm:border-b-0 border-slate-200/80">
      <div class="px-4 py-3 sm:px-0 sm:py-0 sm:pb-3 sm:mb-6 flex items-center justify-between border-b border-slate-200">
        <h2 class="text-[11px] sm:text-xs font-black uppercase tracking-wider text-slate-400 font-mono">
          Semua Tulisan ({sortedPosts.length})
        </h2>
      </div>

      <div class="divide-y divide-slate-100 sm:divide-y-0 sm:space-y-6">
        {sortedPosts.map((post) => {
          const formattedDate = new Intl.DateTimeFormat('id-ID', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }).format(new Date(post.data.date));

          const primaryCategory = post.data.categories?.[0] || 'Esai';
          const postSlug = post.id.replace(/\.mdx?$/, '');

          return (
            <article class="group bg-white px-4 py-5 sm:p-7 rounded-none sm:rounded-2xl border-x-0 sm:border border-slate-200/80 hover:border-amber-500/40 hover:shadow-xs transition-all duration-200 relative">
              <div class="flex flex-col sm:flex-row gap-5 sm:gap-6 items-start">
                {post.data.image && (
                  <div class="w-full sm:w-52 lg:w-60 aspect-[16/10] rounded-xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200/70">
                    <img 
                      src={post.data.image} 
                      alt={post.data.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch">
                  <div>
                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 mb-2 sm:mb-2.5">
                      <span class="text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200/60 font-semibold font-mono text-[10px] sm:text-[11px]">
                        {primaryCategory}
                      </span>
                      <span>•</span>
                      <time datetime={post.data.date.toISOString()} class="text-slate-500 font-medium text-[11px] sm:text-xs">
                        {formattedDate}
                      </time>
                    </div>

                    <h3 class="text-lg sm:text-2xl font-black text-slate-950 tracking-tight leading-snug mb-2 group-hover:text-amber-600 transition-colors">
                      <a href={`/posts/${postSlug}/`} class="focus:outline-hidden">
                        <span class="absolute inset-0" aria-hidden="true" />
                        {post.data.title}
                      </a>
                    </h3>

                    <p class="text-slate-600 text-xs sm:text-sm leading-relaxed line-clamp-2 mb-3 font-normal">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-[11px] sm:text-xs font-semibold text-slate-500">
                    <span class="text-slate-400 truncate max-w-[150px] sm:max-w-none">Oleh {post.data.author}</span>
                    <span class="text-amber-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 shrink-0 font-bold">
                      Baca Esai →
                    </span>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
