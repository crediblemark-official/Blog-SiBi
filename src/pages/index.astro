---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout 
  title="Blog SiBi — Eksplorasi Mendalam & Strategi Bisnis Digital"
  description="Catatan strategis, studi kasus konversi, dan panduan komprehensif seputar creator economy dari tim SitusBisnis."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Hero Section -->
    <header class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-900 text-xs font-bold uppercase tracking-wider mb-4 font-mono">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Publikasi Resmi SitusBisnis
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-950 leading-[1.15] mb-5">
        Catatan Strategis, Riset, & Panduan Bisnis Digital
      </h1>
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-normal">
        Tulisan mendalam tanpa basa-basi untuk membantu kreator konten, mentor, dan pengusaha digital membangun ekosistem bisnis yang menguntungkan dan mandiri.
      </p>
    </header>

    <!-- Post List Section -->
    <section>
      <div class="flex items-center justify-between pb-4 mb-8 border-b border-slate-200">
        <h2 class="text-xs font-black uppercase tracking-wider text-slate-400 font-mono">
          Semua Tulisan ({sortedPosts.length})
        </h2>
      </div>

      <div class="space-y-8">
        {sortedPosts.map((post) => {
          const formattedDate = new Intl.DateTimeFormat('id-ID', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }).format(new Date(post.data.date));

          const primaryCategory = post.data.categories?.[0] || 'Esai';
          const postSlug = post.id.replace(/\.mdx?$/, '');

          return (
            <article class="group bg-white p-6 sm:p-10 rounded-2xl border border-slate-200/80 hover:border-amber-500/40 hover:shadow-lg transition-all duration-300 relative">
              <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-4">
                <span class="text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200/60 font-semibold font-mono text-[11px]">
                  {primaryCategory}
                </span>
                <span>•</span>
                <time datetime={post.data.date.toISOString()} class="text-slate-500 font-medium">
                  {formattedDate}
                </time>
              </div>

              <h3 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight leading-snug mb-3 group-hover:text-amber-600 transition-colors">
                <a href={`/posts/${postSlug}/`} class="focus:outline-hidden">
                  <span class="absolute inset-0" aria-hidden="true" />
                  {post.data.title}
                </a>
              </h3>

              <p class="text-slate-600 text-base leading-relaxed line-clamp-3 mb-6 font-normal">
                {post.data.description}
              </p>

              <div class="flex items-center justify-between pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500">
                <span class="text-slate-400">Oleh {post.data.author}</span>
                <span class="text-amber-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Baca Esai Lengkap →
                </span>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
