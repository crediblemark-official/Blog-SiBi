---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSeriesContext } from '../../utils/series';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const idPosts = allPosts.filter((p) => (p.data.lang || 'id') === 'id');
  const enPosts = allPosts.filter((p) => p.data.lang === 'en');

  return idPosts.map((post) => {
    const idSlug = post.id.replace(/\.mdx?$/, '');

    // Resolve matching English article where translationOf equals post.id (or post.id without .md)
    let enUrl = '/en/';
    let enPost = null;
    enPost = enPosts.find((en) => {
      const targetSlug = en.data.translationOf?.replace(/\.mdx?$/, '');
      return targetSlug === idSlug || en.data.translationOf === post.id;
    });

    if (enPost) {
      const enSlug = enPost.id.replace(/^en\//, '').replace(/\.mdx?$/, '');
      enUrl = `/en/posts/${enSlug}/`;
    }

    return {
      params: { slug: idSlug },
      props: { 
        post,
        allPosts: idPosts.filter((p) => p.id !== post.id),
        rawAllPosts: allPosts,
        idUrl: `/posts/${idSlug}/`,
        enUrl,
        enPostTitle: enPost?.data?.title,
      },
    };
  });
}

const { post, allPosts, rawAllPosts, idUrl, enUrl, enPostTitle } = Astro.props;
const { Content, headings } = await render(post);

// Estimasi waktu baca (sekitar 200 kata/menit)
const wordCount = post.body ? post.body.split(/\s+/).length : 600;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

// Ambil hingga 3 artikel terkait
const relatedPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// Dapatkan konteks serial jika artikel ini berseri
const seriesContext = getSeriesContext(post, rawAllPosts);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  categories={post.data.categories}
  tags={post.data.tags}
  author={post.data.author}
  image={post.data.image}
  headings={headings}
  readingTimeMinutes={readingTimeMinutes}
  relatedPosts={relatedPosts}
  seriesContext={seriesContext}
  idUrl={idUrl}
  enUrl={enUrl}
  alternateTitle={enPostTitle}
>
  <Content />
</PostLayout>
