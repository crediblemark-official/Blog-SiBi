---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Brand Guidelines & Official Visual Identity Standards — SitusBisnis"
  description="Official visual identity standards, logo assets, color palettes, typography, and trademark guidelines of SitusBisnis for media, partners, creators, and developers."
  breadcrumbs={[
    { name: 'Home', url: '/en/' },
    { name: 'Brand Guide', url: '/en/brand-guide/' },
  ]}
  idUrl="/brand-guide/"
  enUrl="/en/brand-guide/"
>
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
    
    <!-- Header -->
    <header class="mb-10 sm:mb-14 text-center max-w-2xl mx-auto flex flex-col items-center">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4 font-medium" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-amber-600 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-semibold">Brand Guide</span>
      </nav>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-900 text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-3 sm:mb-4 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Official SitusBisnis Visual Standards
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-950 leading-[1.18] mb-3 sm:mb-4">
        SitusBisnis Brand Guidelines
      </h1>

      <p class="text-xs sm:text-base text-slate-600 leading-relaxed font-normal">
        Official visual identity standards, logo assets, color palettes, typography, and trademark guidelines for media, ecosystem partners, creators, and developers.
      </p>
    </header>

    <div class="space-y-12 sm:space-y-16">
      
      <!-- Section 1: Official Logos & Assets -->
      <section class="space-y-6">
        <div class="border-b border-slate-200 pb-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-950">
            1. Official Logos &amp; Emblems
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Always use official high-resolution vector or raster assets without altering aspect ratios.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Logo Card -->
          <div class="bg-white rounded-2xl border border-slate-200/90 p-6 flex flex-col items-center justify-between text-center gap-6 shadow-xs">
            <div class="w-full py-8 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-center">
              <img src="/logo.png" alt="Official SitusBisnis Logo" width="140" height="42" class="h-10 w-auto object-contain" />
            </div>
            <div class="w-full flex items-center justify-between gap-4 text-left">
              <div>
                <p class="text-sm font-bold text-slate-900">Primary Horizontal Logo</p>
                <p class="text-xs text-slate-500">High-resolution transparent PNG</p>
              </div>
              <a href="/logo.png" download="situsbisnis-logo.png" class="px-3.5 py-1.5 text-xs font-bold text-amber-900 bg-amber-50 hover:bg-amber-100 border border-amber-200/70 rounded-lg transition-colors shrink-0">
                Download PNG
              </a>
            </div>
          </div>

          <!-- Icon Emblem Card -->
          <div class="bg-white rounded-2xl border border-slate-200/90 p-6 flex flex-col items-center justify-between text-center gap-6 shadow-xs">
            <div class="w-full py-8 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-center">
              <img src="/favicon.svg" alt="SitusBisnis Emblem Icon" width="48" height="48" class="w-12 h-12 object-contain" />
            </div>
            <div class="w-full flex items-center justify-between gap-4 text-left">
              <div>
                <p class="text-sm font-bold text-slate-900">Emblem Vector Icon</p>
                <p class="text-xs text-slate-500">Scalable SVG format</p>
              </div>
              <a href="/favicon.svg" download="situsbisnis-icon.svg" class="px-3.5 py-1.5 text-xs font-bold text-amber-900 bg-amber-50 hover:bg-amber-100 border border-amber-200/70 rounded-lg transition-colors shrink-0">
                Download SVG
              </a>
            </div>
          </div>
        </div>

        <!-- Rules Box -->
        <div class="bg-slate-50 rounded-xl border border-slate-200/80 p-5 text-xs sm:text-sm space-y-3 text-slate-600">
          <p class="font-bold text-slate-900 flex items-center gap-1.5">
            <span class="text-amber-600">✓</span> Logo Usage Guidelines:
          </p>
          <ul class="list-disc list-inside space-y-1.5 text-slate-600">
            <li>Maintain safe clear space around the logo equal to the emblem height.</li>
            <li>Do not rotate, distort aspect ratios, re-color primary elements, or apply unauthorized glow/shadow effects.</li>
            <li>Ensure sufficient background contrast for crisp readability across light and dark interfaces.</li>
            <li>Use the transparent asset variant when superimposing on photographic or colored surfaces.</li>
          </ul>
        </div>
      </section>

      <!-- Section 2: Color Palette -->
      <section class="space-y-6">
        <div class="border-b border-slate-200 pb-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-950">
            2. Official Color Palette
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Engineered color harmony balancing commercial rigor, technological precision, and creator-centric warmth.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <!-- Amber Gold -->
          <div class="bg-white rounded-xl border border-slate-200/90 overflow-hidden shadow-xs">
            <div class="h-20 bg-amber-600"></div>
            <div class="p-3 space-y-0.5">
              <p class="text-xs font-bold text-slate-900">Amber Gold</p>
              <p class="text-[11px] font-mono text-slate-500">#D97706</p>
              <p class="text-[10px] text-slate-400">Primary Brand Accent</p>
            </div>
          </div>

          <!-- Deep Slate -->
          <div class="bg-white rounded-xl border border-slate-200/90 overflow-hidden shadow-xs">
            <div class="h-20 bg-slate-950"></div>
            <div class="p-3 space-y-0.5">
              <p class="text-xs font-bold text-slate-900">Deep Slate</p>
              <p class="text-[11px] font-mono text-slate-500">#020617</p>
              <p class="text-[10px] text-slate-400">Headings &amp; Core Dark</p>
            </div>
          </div>

          <!-- Warm Amber -->
          <div class="bg-white rounded-xl border border-slate-200/90 overflow-hidden shadow-xs">
            <div class="h-20 bg-amber-500"></div>
            <div class="p-3 space-y-0.5">
              <p class="text-xs font-bold text-slate-900">Warm Amber</p>
              <p class="text-[11px] font-mono text-slate-500">#F59E0B</p>
              <p class="text-[10px] text-slate-400">Interactive &amp; Hover</p>
            </div>
          </div>

          <!-- Neutral Slate -->
          <div class="bg-white rounded-xl border border-slate-200/90 overflow-hidden shadow-xs">
            <div class="h-20 bg-slate-600"></div>
            <div class="p-3 space-y-0.5">
              <p class="text-xs font-bold text-slate-900">Neutral Slate</p>
              <p class="text-[11px] font-mono text-slate-500">#475569</p>
              <p class="text-[10px] text-slate-400">Body &amp; Subtitle</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Typography Hierarchy -->
      <section class="space-y-6">
        <div class="border-b border-slate-200 pb-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-950">
            3. Typography Standards
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Typographic hierarchy ensuring high legibility and cohesive presentation across web, mobile, and documentation.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl border border-slate-200/90 p-5 space-y-3 shadow-xs">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200/70">Primary Sans-Serif</span>
              <span class="text-xs text-slate-400">Plus Jakarta Sans / Inter</span>
            </div>
            <p class="text-2xl font-black text-slate-950 tracking-tight">Sovereign Creators, Independent Commerce</p>
            <p class="text-xs text-slate-600 leading-relaxed">
              Standardized for editorial headlines, call-to-actions, paragraph copy, and checkout interfaces.
            </p>
          </div>

          <div class="bg-white rounded-xl border border-slate-200/90 p-5 space-y-3 shadow-xs">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">Primary Monospace</span>
              <span class="text-xs text-slate-400">JetBrains Mono / SF Mono</span>
            </div>
            <p class="text-xl font-black font-mono text-slate-950">Rp 18,450,000 — 0% TAKE-RATE</p>
            <p class="text-xs text-slate-600 leading-relaxed">
              Used for financial currency values, QRIS payload data, invoice tokens, webhook identifiers, and technical badges.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Brand Standards & Trademarks -->
      <section class="space-y-6">
        <div class="border-b border-slate-200 pb-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-950">
            4. Trademark &amp; Entity Nomenclature
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Standard conventions for referencing SitusBisnis across media, articles, and ecosystem integrations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Correct -->
          <div class="bg-emerald-50/70 border border-emerald-200/80 rounded-xl p-5 space-y-3">
            <p class="text-xs font-black uppercase tracking-wider text-emerald-800 flex items-center gap-1.5 font-mono">
              <span>✓</span> Approved Formatting
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-emerald-950">
              <li><strong>SitusBisnis</strong> — Official platform name (single word, CamelCase capital S and B).</li>
              <li><strong>situsbisnis.com</strong> — Official domain address (all lowercase).</li>
              <li><strong>PT HORIZON DIGITAL INDONESIA</strong> — Official legal operating entity.</li>
              <li><strong>Blog SiBi</strong> — Official strategic publication channel of SitusBisnis.</li>
            </ul>
          </div>

          <!-- Avoid -->
          <div class="bg-rose-50/70 border border-rose-200/80 rounded-xl p-5 space-y-3">
            <p class="text-xs font-black uppercase tracking-wider text-rose-800 flex items-center gap-1.5 font-mono">
              <span>✕</span> Formatting to Avoid
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-rose-950">
              <li><em>Situs Bisnis</em> (separated into two words).</li>
              <li><em>Situs-Bisnis</em> or <em>situs_bisnis</em> (hyphenated or underscored).</li>
              <li><em>SitusBisnis dot com</em> (colloquial phonetic spelling).</li>
              <li><em>situsbisnis.id</em> or <em>situsbisnis.co.id</em> (unauthorized TLD references).</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 5: Media Inquiries -->
      <section class="bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 space-y-4 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-slate-950">
          Media Inquiries &amp; Asset Licensing
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Journalists, content creators, researchers, and ecosystem partners are welcome to embed official SitusBisnis branding for editorial coverage, educational analyses, and partnership badges, provided appropriate attribution links to <a href="https://situsbisnis.com" class="font-bold text-amber-600 underline">https://situsbisnis.com</a> are preserved.
        </p>
        <div class="pt-2 flex flex-wrap gap-3">
          <a href="https://situsbisnis.com/kontak" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 text-white text-xs font-bold transition-colors">
            Contact Media &amp; PR Relations &rarr;
          </a>
          <a href="https://situsbisnis.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold transition-colors">
            Visit SitusBisnis Platform
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
