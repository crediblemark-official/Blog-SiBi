---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { slugify } from '../../../utils/slug';
import { CATEGORY_NAMES_EN } from '../../../utils/categories';

const allPosts = await getCollection('blog');
const posts = allPosts.filter((p) => p.data.lang === 'en');

// Aggregate categories with their post lists
const categoryMap = new Map<string, { name: string; posts: CollectionEntry<'blog'>[] }>();

for (const post of posts) {
  for (const cat of (post.data.categories || [])) {
    let slug = slugify(cat);
    if (slug === 'sales-funnels') slug = 'sales-funnel';
    if (!categoryMap.has(slug)) {
      categoryMap.set(slug, { name: CATEGORY_NAMES_EN[slug] || cat, posts: [] });
    }
    categoryMap.get(slug)!.posts.push(post);
  }
}

const categories = Array.from(categoryMap.entries()).map(([slug, data]) => ({
  slug,
  name: data.name,
  count: data.posts.length,
  recentPosts: data.posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 2)
}));
---

<BaseLayout 
  title="All Categories — Blog SiBi"
  description="Explore all strategic essay categories, monetization frameworks, and digital business guides on Blog SiBi."
  breadcrumbs={[
    { name: 'Home', url: '/en/' },
    { name: 'Categories', url: '/en/kategori/' },
  ]}
  idUrl="/kategori/"
  enUrl="/en/kategori/"
>
  <div class="w-full max-w-7xl mx-auto px-0 sm:px-6 lg:px-8 py-4 sm:py-12 lg:py-14">
    
    <!-- Header -->
    <header class="w-full max-w-3xl mx-auto px-4 sm:px-6 mb-10 sm:mb-16 text-center flex flex-col items-center">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4 font-medium" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-amber-600 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-semibold">Categories</span>
      </nav>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-900 text-[10px] sm:text-xs font-bold uppercase tracking-wider mb-3 sm:mb-4 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Topic &amp; Category Index
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-950 leading-[1.18] mb-3 sm:mb-4">
        Explore by Category
      </h1>

      <p class="text-xs sm:text-base text-slate-600 leading-relaxed font-normal max-w-xl">
        Select a core domain to study structured frameworks on monetization, conversion optimization, and sovereign audience acquisition.
      </p>
    </header>

    <!-- Categories Grid -->
    <div class="px-4 sm:px-0 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16 sm:mb-24">
      {categories.map((cat) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 hover:border-amber-400 p-6 sm:p-7 transition-all hover:shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200/60">
                {cat.count} Articles
              </span>
              <a 
                href={`/en/kategori/${cat.slug}/`}
                class="text-xs font-semibold text-amber-600 hover:text-amber-700 flex items-center gap-1 group"
              >
                <span>View All</span>
                <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
              </a>
            </div>

            <h2 class="text-lg sm:text-xl font-bold text-slate-950 mb-4 hover:text-amber-600 transition-colors">
              <a href={`/en/kategori/${cat.slug}/`}>
                {cat.name}
              </a>
            </h2>

            <!-- Recent Posts in Category -->
            <div class="space-y-3 pt-3 border-t border-slate-100">
              {cat.recentPosts.map((rPost) => {
                const rSlug = rPost.id.replace(/^en\//, '').replace(/\.mdx?$/, '');
                return (
                  <a 
                    href={`/en/posts/${rSlug}/`}
                    class="block group/post"
                  >
                    <p class="text-xs sm:text-sm font-semibold text-slate-800 group-hover/post:text-amber-600 line-clamp-1 transition-colors">
                      {rPost.data.title}
                    </p>
                    <span class="text-[11px] text-slate-400">
                      {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(rPost.data.date))}
                    </span>
                  </a>
                );
              })}
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100">
            <a 
              href={`/en/kategori/${cat.slug}/`}
              class="w-full inline-flex items-center justify-center gap-1.5 py-2 rounded-xl bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 hover:border-amber-200 text-xs font-bold transition-all"
            >
              <span>Explore {cat.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>
